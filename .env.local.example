# Copy to .env.local for local dev. In production, set these in
# Vercel → Project → Settings → Environment Variables (never commit real values).

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Store email notification (Resend). ORDER_FROM_EMAIL must be on a domain
# verified in Resend, e.g. "Cupbop Orders <orders@cupbop.mingyudev.com>".
RESEND_API_KEY=
ORDER_FROM_EMAIL=
STORE_NOTIFICATION_EMAIL=

# Optional store SMS (Twilio). Leave blank to keep SMS off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
STORE_NOTIFICATION_PHONE=

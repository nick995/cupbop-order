# Copy to .env.local for local dev. In production, set these in
# Vercel → Project → Settings → Environment Variables (never commit real values).

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Store email notification (Resend). ORDER_FROM_EMAIL must be on a domain
# verified in Resend, e.g. "Cupbop Orders <orders@cupbop.mingyudev.com>".
RESEND_API_KEY=
ORDER_FROM_EMAIL=
# Comma-separated list of store inboxes.
STORE_NOTIFICATION_EMAIL=mjung@cupbop.com,lryan@cupbop.com

# Signs the "Confirm order" links in store emails. Generate with: openssl rand -hex 32
ORDER_ACTION_SECRET=
# Bearer token the hourly GitHub Action sends to /api/cron/reminders. openssl rand -hex 32
CRON_SECRET=
# Who can sign in to /admin (accounts are created in Supabase → Authentication → Users).
ADMIN_EMAILS=mingyu995@gmail.com,mjung@cupbop.com,lryan@cupbop.com

# Public URL used in email links (falls back to the request's origin).
SITE_URL=https://cupbop.mingyudev.com

# Optional store SMS (Twilio). Leave blank to keep SMS off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
STORE_NOTIFICATION_PHONE=
